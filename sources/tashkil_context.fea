@CTX_BIG = [damma-ar dammatan-ar];

lookup CTX_RAISE_TEH { pos @CTX_ABOVE <0 314 0 0>; } CTX_RAISE_TEH;
lookup CTX_RAISE_NOON { pos @CTX_ABOVE <0 247 0 0>; } CTX_RAISE_NOON;
lookup CTX_LOWER_BEH { pos @CTX_ABOVE <0 -190 0 0>; } CTX_LOWER_BEH;
lookup CTX_HAH_RIGHT { pos @CTX_ABOVE <140 0 0 0>; } CTX_HAH_RIGHT;
lookup CTX_MEEM_KASRA { pos @CTX_BELOW <0 -140 0 0>; } CTX_MEEM_KASRA;
lookup CTX_MEEM_UP { pos @CTX_ABOVE <0 160 0 0>; } CTX_MEEM_UP;
lookup CTX_NEXT_LEFT { pos @CTX_ABOVE <-100 0 0 0>; } CTX_NEXT_LEFT;
lookup CTX_BIG_SHIFT { pos @CTX_BIG <30 60 0 0>; } CTX_BIG_SHIFT;

feature mark {
    # teh before kaf
    pos [teh-ar.init] @CTX_ABOVE' lookup CTX_RAISE_TEH @CTX_KAF;
    pos [teh-ar.init] @CTX_ABOVE' lookup CTX_RAISE_TEH @CTX_ABOVE' lookup CTX_RAISE_TEH @CTX_KAF;
    pos [teh-ar.init] @CTX_BELOW @CTX_ABOVE' lookup CTX_RAISE_TEH @CTX_KAF;
    pos [teh-ar.init] @CTX_ABOVE' lookup CTX_RAISE_TEH @CTX_BELOW @CTX_KAF;
    pos [teh-ar.init] @CTX_BELOW @CTX_ABOVE' lookup CTX_RAISE_TEH @CTX_ABOVE' lookup CTX_RAISE_TEH @CTX_KAF;
    # noon before kaf
    pos [noon-ar.init] @CTX_ABOVE' lookup CTX_RAISE_NOON @CTX_KAF;
    pos [noon-ar.init] @CTX_ABOVE' lookup CTX_RAISE_NOON @CTX_ABOVE' lookup CTX_RAISE_NOON @CTX_KAF;
    pos [noon-ar.init] @CTX_BELOW @CTX_ABOVE' lookup CTX_RAISE_NOON @CTX_KAF;
    pos [noon-ar.init] @CTX_ABOVE' lookup CTX_RAISE_NOON @CTX_BELOW @CTX_KAF;
    pos [noon-ar.init] @CTX_BELOW @CTX_ABOVE' lookup CTX_RAISE_NOON @CTX_ABOVE' lookup CTX_RAISE_NOON @CTX_KAF;
    # beh before kaf
    pos [beh-ar.init] @CTX_ABOVE' lookup CTX_LOWER_BEH @CTX_KAF;
    pos [beh-ar.init] @CTX_ABOVE' lookup CTX_LOWER_BEH @CTX_ABOVE' lookup CTX_LOWER_BEH @CTX_KAF;
    pos [beh-ar.init] @CTX_BELOW @CTX_ABOVE' lookup CTX_LOWER_BEH @CTX_KAF;
    pos [beh-ar.init] @CTX_ABOVE' lookup CTX_LOWER_BEH @CTX_BELOW @CTX_KAF;
    pos [beh-ar.init] @CTX_BELOW @CTX_ABOVE' lookup CTX_LOWER_BEH @CTX_ABOVE' lookup CTX_LOWER_BEH @CTX_KAF;
    # marks of hah/jeem/kha after lam.init.LamHaaInit
    pos [lam-ar.init.LamHaaInit] @CTX_HAH @CTX_ABOVE' lookup CTX_HAH_RIGHT;
    pos [lam-ar.init.LamHaaInit] @CTX_HAH @CTX_ABOVE' lookup CTX_HAH_RIGHT @CTX_ABOVE' lookup CTX_HAH_RIGHT;
    pos [lam-ar.init.LamHaaInit] @CTX_HAH @CTX_BELOW @CTX_ABOVE' lookup CTX_HAH_RIGHT;
    pos [lam-ar.init.LamHaaInit] @CTX_HAH @CTX_BELOW @CTX_ABOVE' lookup CTX_HAH_RIGHT @CTX_ABOVE' lookup CTX_HAH_RIGHT;
    pos [lam-ar.init.LamHaaInit] @CTX_ALL @CTX_HAH @CTX_ABOVE' lookup CTX_HAH_RIGHT;
    pos [lam-ar.init.LamHaaInit] @CTX_ALL @CTX_HAH @CTX_ABOVE' lookup CTX_HAH_RIGHT @CTX_ABOVE' lookup CTX_HAH_RIGHT;
    pos [lam-ar.init.LamHaaInit] @CTX_ALL @CTX_HAH @CTX_BELOW @CTX_ABOVE' lookup CTX_HAH_RIGHT;
    pos [lam-ar.init.LamHaaInit] @CTX_ALL @CTX_HAH @CTX_BELOW @CTX_ABOVE' lookup CTX_HAH_RIGHT @CTX_ABOVE' lookup CTX_HAH_RIGHT;
    # kasra of meem.medi.LamMemInit before final yeh
    pos [meem-ar.medi.LamMemInit meem-ar.medi.LamMemInitTatweel] @CTX_BELOW' lookup CTX_MEEM_KASRA @CTX_YEH;
    pos [meem-ar.medi.LamMemInit meem-ar.medi.LamMemInitTatweel] @CTX_BELOW' lookup CTX_MEEM_KASRA @CTX_BELOW' lookup CTX_MEEM_KASRA @CTX_YEH;
    pos [meem-ar.medi.LamMemInit meem-ar.medi.LamMemInitTatweel] @CTX_ABOVE @CTX_BELOW' lookup CTX_MEEM_KASRA @CTX_YEH;
    pos [meem-ar.medi.LamMemInit meem-ar.medi.LamMemInitTatweel] @CTX_BELOW' lookup CTX_MEEM_KASRA @CTX_ABOVE @CTX_YEH;
    pos [meem-ar.medi.LamMemInit meem-ar.medi.LamMemInitTatweel] @CTX_ABOVE @CTX_BELOW' lookup CTX_MEEM_KASRA @CTX_BELOW' lookup CTX_MEEM_KASRA @CTX_YEH;
    # mark of meem.medi.LamMemInit before final alef: above the tips of both stems
    pos [meem-ar.medi.LamMemInit] @CTX_ABOVE' lookup CTX_MEEM_UP @CTX_ALEF;
    pos [meem-ar.medi.LamMemInit] @CTX_ABOVE' lookup CTX_MEEM_UP @CTX_ABOVE' lookup CTX_MEEM_UP @CTX_ALEF;
    pos [meem-ar.medi.LamMemInit] @CTX_BELOW @CTX_ABOVE' lookup CTX_MEEM_UP @CTX_ALEF;
    pos [meem-ar.medi.LamMemInit] @CTX_ABOVE' lookup CTX_MEEM_UP @CTX_BELOW @CTX_ALEF;
    pos [meem-ar.medi.LamMemInit] @CTX_BELOW @CTX_ABOVE' lookup CTX_MEEM_UP @CTX_ABOVE' lookup CTX_MEEM_UP @CTX_ALEF;
    # after feh + hah/jeem/kha with more letters: marks of the next letter shift left
    pos @CTX_FFOL @CTX_NEXT @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_NEXT @CTX_ABOVE' lookup CTX_NEXT_LEFT @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_NEXT @CTX_BELOW @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_NEXT @CTX_BELOW @CTX_ABOVE' lookup CTX_NEXT_LEFT @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_ALL @CTX_NEXT @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_ALL @CTX_NEXT @CTX_ABOVE' lookup CTX_NEXT_LEFT @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_ALL @CTX_NEXT @CTX_BELOW @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_ALL @CTX_NEXT @CTX_BELOW @CTX_ABOVE' lookup CTX_NEXT_LEFT @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_ALL @CTX_ALL @CTX_NEXT @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_ALL @CTX_ALL @CTX_NEXT @CTX_ABOVE' lookup CTX_NEXT_LEFT @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_ALL @CTX_ALL @CTX_NEXT @CTX_BELOW @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    pos @CTX_FFOL @CTX_ALL @CTX_ALL @CTX_NEXT @CTX_BELOW @CTX_ABOVE' lookup CTX_NEXT_LEFT @CTX_ABOVE' lookup CTX_NEXT_LEFT;
    # damma/dammatan of that hah/jeem/kha: a little up and to the right
    pos @CTX_FFOL @CTX_BIG' lookup CTX_BIG_SHIFT @CTX_NEXT;
    pos @CTX_FFOL @CTX_ALL @CTX_BIG' lookup CTX_BIG_SHIFT @CTX_NEXT;
} mark;
